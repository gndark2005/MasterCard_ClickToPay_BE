{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "FileLogging": {
    "Directory": "logs",
    "RetainedDays": 30
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "ClickToPay": ""
  },
  "Cors": {
    "AllowedOrigins": [ "https://staging.ptranz.com" ]
  },
  "Authentication": {
    "ApiKey": "clicktopay-dev-key"
  },
  "PayloadEncryption": {
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "MastercardApi": {
    "BaseUrl": "https://sandbox.api.mastercard.com",
    "ConsumerKey": "",
    "SigningKeyPath": "",
    "SigningKeyPassword": ""
  },
  "CheckoutTransactionFile": {
    "Directory": "transactions"
  },
  "PaymentSimulation": {
    "Outcome": "Approved"
  },
  "PowerTranz": {
    "BaseUrl": "https://staging.ptranz.com",
    "PowerTranzId": "",
    "PowerTranzPassword": "",
    "Transaction": "Auth",
    "TimeoutSeconds": 60,
    "CryptogramSourceField": "",
    "EciSourceField": ""
  }
}
